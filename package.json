{
  "name": "synergy-drafthouse",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Synergy Drafthouse — cooling-tower engineering, every step shown. Open cooling-tower engineering calculations: Merkel thermal rating, air-side and fan balance, water balance, and component selection, with step-by-step worked derivations.",
  "scripts": {
    "cockpit-build": "bash cockpit/tools/build-web.sh release",
    "cockpit-artifact": "node scripts/cockpit-artifact.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "static": "node scripts/static-check.mjs",
    "version-check": "node scripts/version-check.mjs",
    "native-icons": "node scripts/native-icons.mjs",
    "native-icons-check": "node scripts/native-icons.mjs --check",
    "native-artifacts": "node scripts/native-artifacts.mjs",
    "native-manifest": "node scripts/native-manifest.mjs",
    "native-verify": "node scripts/native-verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "server-smoke": "node scripts/server-smoke.mjs",
    "validate": "npm run static && npm run version-check && npm run native-icons-check && npm test && npm run smoke && npm run server-smoke && npm run deploy-check && npm run parity-wasm && npm run bundle-check && npm run retirement-check",
    "deploy-check": "node scripts/deploy-check.mjs",
    "deploy-manifest": "node scripts/deploy-check.mjs --write-manifest",
    "deploy-audit": "node scripts/deploy-audit.mjs",
    "parity-wasm": "node scripts/parity/run.mjs --engine wasm",
    "bundle": "node scripts/bundle.mjs",
    "bundle-check": "node scripts/bundle-check.mjs",
    "retirement-check": "node scripts/retirement-check.mjs",
    "release-assemble": "node scripts/release-assemble.mjs",
    "release-verify": "node scripts/release-verify.mjs",
    "release-repro": "node scripts/release-repro.mjs",
    "deployment-serving": "node --test tests/deployment-serving.test.js",
    "deployment-check": "node scripts/deploytest-serve.mjs --check",
    "deployment-audit": "node scripts/deploytest-audit.mjs",
    "deployment-probe": "node scripts/deploytest-probe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE"
}
